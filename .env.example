# 环境变量模板
# 复制为 .env.local，填入你的真实值

# LLM Provider: openai | deepseek | zhipu | qwen | moonshot
LLM_PROVIDER=deepseek

# API Key（不同 Provider 去对应平台获取）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型名称（可选，留空使用默认模型）
# LLM_MODEL=

# 自定义 API 地址（可选，用于 One-API / 中转站 / 代理）
# LLM_BASE_URL=

# 嵌入模型下载源（可选）
# 本地/国内默认 hf-mirror.com（规避被墙）；海外服务器（Vercel）建议设为
# HF_ENDPOINT=https://huggingface.co ，官方源在海外下载更快
# HF_ENDPOINT=

# 站点名称（可选，显示在浏览器标签页）
NEXT_PUBLIC_SITE_NAME=ResumeAI

# Dashboard 访问密码（设置后可通过 /dashboard?key=xxx 访问审核后台）
DASHBOARD_SECRET=你的密码
